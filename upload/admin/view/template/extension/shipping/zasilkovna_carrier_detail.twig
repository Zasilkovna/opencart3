{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-carrier-detail" data-toggle="tooltip" title="{{ button_save|e }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ link_cancel }}" data-toggle="tooltip" title="{{ button_back|e }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ text_carriers }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text|e }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if success %}
      <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success|e }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning|e }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ carrier_form_name|e }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ link_form_action }}" method="post" enctype="multipart/form-data" id="form-carrier-detail" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-is-enabled">{{ entry_sr_is_enabled|e }}</label>
            <div class="col-sm-10">
              <select name="is_enabled" id="input-is-enabled" class="form-control">
                <option value="1" {% if is_enabled == 1 %} selected="selected"{% endif %}>{{ text_enabled|e }}</option>
                <option value="0" {% if is_enabled == 0 %} selected="selected"{% endif %}>{{ text_disabled|e }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-carrier-name">{{ entry_sr_name|e }}</label>
            <div class="col-sm-10">
              <input type="text" name="carrier_name" value="{{ carrier_name|e }}" placeholder="{{ carrier_name_placeholder|e }}" id="input-carrier-name" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-rate-type">{{ entry_sr_rate_type|e }}</label>
            <div class="col-sm-10">
              <select name="rate_type" id="input-rate-type" class="form-control">
                {% for rateTypeOption in rate_types %}
                  <option value="{{ rateTypeOption.code|e }}" {% if rateTypeOption.code == rate_type %}selected="selected"{% endif %}>{{ rateTypeOption.label|e }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group" id="default-price-form-group">
            <label class="col-sm-2 control-label" for="input-default-price">
              <span data-toggle="tooltip" title="{{ help_default_shipping_rule_price|e }}">{{ entry_sr_default_price|e }}</span>
            </label>
            <div class="col-sm-10">
              <input type="number" step="0.01" min="0" name="default_price" value="{{ default_price|e }}" placeholder="{{ entry_sr_default_price|e }}" id="input-default-price" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-free-shipping-limit">{{ entry_sr_free_over_limit|e }}</label>
            <div class="col-sm-10">
              <input type="number" step="0.01" min="0" name="free_shipping_limit" value="{{ free_shipping_limit|e }}" placeholder="{{ entry_sr_free_over_limit|e }}" id="input-free-shipping-limit" class="form-control" />
            </div>
          </div>
          <fieldset id="shipping-rule-limits-fieldset">
            <legend id="shipping-rule-limits-legend">{{ text_sr_weight_based_rate|e }}</legend>
            <table id="weight-limit-table" class="table table-striped table-bordered table-hover">
              <thead>
                <tr>
                  <td class="text-left">{{ entry_sr_weight_to|e }}</td>
                  <td class="text-left">{{ entry_sr_rule_price|e }}</td>
                  <td></td>
                </tr>
              </thead>
              <tbody>
              {% set weight_limit_row = 0 %}
              {% for weight_rule in weight_limits %}
                <tr id="weight-limit-row{{ weight_limit_row }}">
                  <td class="text-left">
                    <input type="number" step="0.01" min="0" name="weight_limits[{{ weight_limit_row }}][value]" value="{{ weight_rule.value|e }}" placeholder="{{ entry_sr_weight_to|e }}" class="form-control" />
                  </td>
                  <td class="text-left">
                    <input type="number" step="0.01" min="0" name="weight_limits[{{ weight_limit_row }}][price]" value="{{ weight_rule.price|e }}" placeholder="{{ entry_sr_rule_price|e }}" class="form-control" />
                  </td>
                  <td class="text-left">
                    <button type="button" onclick="$('#weight-limit-row{{ weight_limit_row }}').remove(); packeteryEnsureMinimumLimitRowForSelectedRateType();" data-toggle="tooltip" title="{{ button_remove|e }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
                  </td>
                </tr>
                {% set weight_limit_row = weight_limit_row + 1 %}
              {% endfor %}
              </tbody>
            </table>
            <table id="total-price-limit-table" class="table table-striped table-bordered table-hover">
              <thead>
                <tr>
                  <td class="text-left">{{ entry_sr_total_to|e }}</td>
                  <td class="text-left">{{ entry_sr_rule_price|e }}</td>
                  <td></td>
                </tr>
              </thead>
              <tbody>
              {% set total_price_limit_row = 0 %}
              {% for total_price_rule in total_price_limits %}
                <tr id="total-price-limit-row{{ total_price_limit_row }}">
                  <td class="text-left">
                    <input type="number" step="0.01" min="0" name="total_price_limits[{{ total_price_limit_row }}][value]" value="{{ total_price_rule.value|e }}" placeholder="{{ entry_sr_total_to|e }}" class="form-control" />
                  </td>
                  <td class="text-left">
                    <input type="number" step="0.01" min="0" name="total_price_limits[{{ total_price_limit_row }}][price]" value="{{ total_price_rule.price|e }}" placeholder="{{ entry_sr_rule_price|e }}" class="form-control" />
                  </td>
                  <td class="text-left">
                    <button type="button" onclick="$('#total-price-limit-row{{ total_price_limit_row }}').remove(); packeteryEnsureMinimumLimitRowForSelectedRateType();" data-toggle="tooltip" title="{{ button_remove|e }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
                  </td>
                </tr>
                {% set total_price_limit_row = total_price_limit_row + 1 %}
              {% endfor %}
              </tbody>
            </table>
            <div class="text-right">
              <button type="button" onclick="packeteryAddLimitRowForSelectedRateType();" data-toggle="tooltip" title="{{ button_sr_rule_add|e }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
var packeteryWeightLimitRowIndex = {{ weight_limit_row }};
var packeteryTotalPriceLimitRowIndex = {{ total_price_limit_row }};

function packeteryAddWeightLimitRow() {
  var rowHtml  = '<tr id="weight-limit-row' + packeteryWeightLimitRowIndex + '">';
  rowHtml += '  <td class="text-left">';
  rowHtml += '    <input type="number" step="0.01" min="0" name="weight_limits[' + packeteryWeightLimitRowIndex + '][value]" value="" placeholder="{{ entry_sr_weight_to|e('js') }}" class="form-control" />';
  rowHtml += '  </td>';
  rowHtml += '  <td class="text-left"><input type="number" step="0.01" min="0" name="weight_limits[' + packeteryWeightLimitRowIndex + '][price]" value="" placeholder="{{ entry_sr_rule_price|e('js') }}" class="form-control" /></td>';
  rowHtml += '  <td class="text-left"><button type="button" onclick="$(\'#weight-limit-row' + packeteryWeightLimitRowIndex + '\').remove(); packeteryEnsureMinimumLimitRowForSelectedRateType();" data-toggle="tooltip" title="{{ button_remove|e('js') }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
  rowHtml += '</tr>';

  $('#weight-limit-table tbody').append(rowHtml);

  packeteryWeightLimitRowIndex++;
}

function packeteryAddTotalPriceLimitRow() {
  var rowHtml  = '<tr id="total-price-limit-row' + packeteryTotalPriceLimitRowIndex + '">';
  rowHtml += '  <td class="text-left">';
  rowHtml += '    <input type="number" step="0.01" min="0" name="total_price_limits[' + packeteryTotalPriceLimitRowIndex + '][value]" value="" placeholder="{{ entry_sr_total_to|e('js') }}" class="form-control" />';
  rowHtml += '  </td>';
  rowHtml += '  <td class="text-left"><input type="number" step="0.01" min="0" name="total_price_limits[' + packeteryTotalPriceLimitRowIndex + '][price]" value="" placeholder="{{ entry_sr_rule_price|e('js') }}" class="form-control" /></td>';
  rowHtml += '  <td class="text-left"><button type="button" onclick="$(\'#total-price-limit-row' + packeteryTotalPriceLimitRowIndex + '\').remove(); packeteryEnsureMinimumLimitRowForSelectedRateType();" data-toggle="tooltip" title="{{ button_remove|e('js') }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
  rowHtml += '</tr>';

  $('#total-price-limit-table tbody').append(rowHtml);

  packeteryTotalPriceLimitRowIndex++;
}

function packeteryAddLimitRowForSelectedRateType() {
  var selectedRateTypeCode = $('#input-rate-type').val();
  if (selectedRateTypeCode === '{{ rate_type_weight_based|e('js') }}') {
    packeteryAddWeightLimitRow();
  }
  if (selectedRateTypeCode === '{{ rate_type_total_based|e('js') }}') {
    packeteryAddTotalPriceLimitRow();
  }
}

function packeteryEnsureMinimumLimitRowForSelectedRateType() {
  var selectedRateTypeCode = $('#input-rate-type').val();
  if (selectedRateTypeCode === '{{ rate_type_default_price|e('js') }}') {
    return;
  }
  if (selectedRateTypeCode === '{{ rate_type_weight_based|e('js') }}' && $('#weight-limit-table tbody tr').length === 0) {
    packeteryAddWeightLimitRow();
  }
  if (selectedRateTypeCode === '{{ rate_type_total_based|e('js') }}' && $('#total-price-limit-table tbody tr').length === 0) {
    packeteryAddTotalPriceLimitRow();
  }
}

function packeterySyncRateTypeDependentSections() {
  var selectedRateTypeCode = $('#input-rate-type').val();
  var isDefaultPriceRateType = selectedRateTypeCode === '{{ rate_type_default_price|e('js') }}';
  var isTotalBasedRateType = selectedRateTypeCode === '{{ rate_type_total_based|e('js') }}';

  if (isDefaultPriceRateType) {
    $('#default-price-form-group').show();
    $('#shipping-rule-limits-fieldset').hide();
  } else {
    $('#default-price-form-group').hide();
    $('#shipping-rule-limits-fieldset').show();
  }

  if (isTotalBasedRateType) {
    $('#shipping-rule-limits-legend').text('{{ text_sr_total_based_rate|e('js') }}');
    $('#weight-limit-table').hide();
    $('#total-price-limit-table').show();
  } else {
    $('#shipping-rule-limits-legend').text('{{ text_sr_weight_based_rate|e('js') }}');
    $('#weight-limit-table').show();
    $('#total-price-limit-table').hide();
  }

  packeteryEnsureMinimumLimitRowForSelectedRateType();
}

$('#input-rate-type').on('change', function() {
  packeterySyncRateTypeDependentSections();
});

packeterySyncRateTypeDependentSections();
//--></script>
{{ footer }}
